# Configuración pública (no secreta) de la web. Valores por defecto para todos los entornos;
# en Vercel se pueden sobrescribir por entorno (Production / Preview / Development).

# WhatsApp de Magic H4nds (formato internacional sin "+"). Los encargos y botones abren este chat.
NEXT_PUBLIC_WHATSAPP=573115685168

# URL pública del sitio (enlaces absolutos, Open Graph, y más adelante el login).
