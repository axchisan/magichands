{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Alternativa de despliegue en Cloudflare Workers (el despliegue principal es Vercel).
	// Ver ../docs/06-infraestructura-y-costes.md
	"name": "magich4nds-demo",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Autorreferencia que usa OpenNext; el nombre debe coincidir con "name"
			"binding": "WORKER_SELF_REFERENCE",
			"service": "magich4nds-demo"
		}
	],
	"observability": { "enabled": true }
}
